{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mailmind",
  "version": "0.1.0",
  "identifier": "com.raphaeljafri.mailmind",
  "build": {
    "beforeDevCommand": "npm --prefix ../webview run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../webview run build",
    "frontendDist": "../webview/dist"
  },
  "app": {
    "windows": [
      {
        "title": "mailmind",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
