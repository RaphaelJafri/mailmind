{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageTag",
  "description": "Tagger output for one message. Three orthogonal tag dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "tags", "confidence"],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urgency", "category"],
      "properties": {
        "urgency": {
          "enum": ["urgent", "followup", "informational", "automated", "ignore"]
        },
        "category": {
          "enum": [
            "recruiting",
            "legal",
            "personal",
            "finance",
            "vendor",
            "newsletter",
            "transactional",
            "other"
          ]
        },
        "project": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        }
      }
    },
    "rationale": { "type": "string", "maxLength": 300 },
    "confidence": { "enum": ["high", "medium", "low"] }
  }
}
